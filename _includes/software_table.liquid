<div class="table-responsive" tabindex="0" role="region" aria-label="Software purposes, status, roles and evidence">
  <table class="table software-table">
    <caption>
      Package roles, development stages and links
    </caption>
    <thead>
      <tr>
        <th scope="col">Software</th>
        <th scope="col">Purpose</th>
        <th scope="col">Status</th>
        <th scope="col">Role and evidence</th>
      </tr>
    </thead>
    <tbody>
      {% for tool in site.data.software %}
        {% assign release = site.data.software_releases.packages[tool.slug] %}
        <tr>
          <th scope="row">
            <a href="{{ '/projects/' | append: tool.slug | append: '/' | relative_url }}">{{ tool.name }}</a>
          </th>
          <td>
            {{ tool.purpose -}}
            {%- if release.docs_url %}
              <br>
              <a href="{{ release.docs_url }}" aria-label="{{ tool.name }} documentation">{{ release.docs_label }}</a>
            {%- endif %}
          </td>
          <td>
            {{ release.display_status -}}
            {%- if release.display_version -%}
              <br>
              Version: {{ release.display_version }}
            {%- endif %}
          </td>
          <td>
            {{ tool.role }}
            {%- if tool.license -%}
              <br>
              License: {{ tool.license }}
            {%- endif -%}
            {%- if tool.source or release.citation_url -%}
              <br>
            {%- endif -%}
            {%- if tool.source -%}
              <a href="{{ tool.source }}" aria-label="{{ tool.name }} source code">Source</a>
            {%- endif -%}
            {%- if tool.source and release.release_archive_url or tool.source and release.citation_url %} · {% endif -%}
            {%- if release.release_archive_url -%}
              <a href="{{ release.release_archive_url }}" aria-label="{{ tool.name }} current release archive">Release archive</a>
            {%- endif -%}
            {%- if release.release_archive_url and release.citation_url %} · {% endif -%}
            {%- if release.citation_url -%}
              <a href="{{ release.citation_url }}" aria-label="{{ tool.name }} citation metadata">
                {%- if release.concept_doi -%}
                  All versions
                {%- else -%}
                  Citation
                {%- endif -%}
              </a>
            {%- endif -%}
            {%- if release.archive_pending -%}
              <br>
              Current-version archive pending verification
            {%- endif -%}
            {%- if tool.citation_note -%}
              <br>
              {{ tool.citation_note }}
            {%- endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
