<div class="col">
  <div class="card h-100 hoverable">
    {% if project.img %}
      {% assign project_img_alt = project.img_alt | default: project.title %}
      {%
        include figure.liquid
        loading="eager"
        path=project.img
        sizes = "250px"
        alt=project_img_alt
        class="card-img-top"
      %}
    {% endif %}
    <div class="card-body">
      <h2 class="card-title">
        <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">{{ project.title }}</a>
      </h2>
      {% assign project_slug = project.path | split: '/' | last | remove: '.md' %}
      {% assign tool = site.data.software | where: 'slug', project_slug | first %}
      {% if tool %}
        <p class="project-status">{{ tool.availability }}</p>
      {% endif %}
      <p class="card-text">{{ project.description }}</p>
      <div class="row ml-1 mr-1 p-0">
        {% if project.github %}
          <div class="github-icon">
            <div class="icon" data-toggle="tooltip" title="Code Repository">
              <a href="{{ project.github }}" aria-label="{{ project.title }} source on GitHub"><i class="fa-brands fa-github gh-icon"></i></a>
            </div>
            {% if project.github_stars %}
              <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                <i class="fa-solid fa-star"></i>
                <span id="{{ project.github_stars }}-stars"></span>
              </span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
