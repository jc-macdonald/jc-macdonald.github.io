{% if entry.status == 'published' or entry.status == 'preprint' %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ScholarlyArticle",
      "@id": {{ entry.doi | prepend: 'https://doi.org/' | jsonify }},
      "headline": {{ entry.title | strip_html | jsonify }},
      "url": {{ entry.html | jsonify }},
      "identifier": {{ entry.doi | jsonify }},
      {% if entry.publication_date %}"datePublished": {{ entry.publication_date | jsonify }},{% else %}"datePublished": {{ entry.year | jsonify }},{% endif %}
      {% if entry.status == 'preprint' %}"creativeWorkStatus": "Preprint",{% endif %}
      {% if entry.journal %}
        "isPartOf": {
          {% if entry.number %}
            "@type": "PublicationIssue", "issueNumber": {{ entry.number | jsonify }}, "isPartOf": {
          {% endif %}
          {% if entry.volume %}
            "@type": "PublicationVolume", "volumeNumber": {{ entry.volume | jsonify }}, "isPartOf": {
          {% endif %}
            "@type": "Periodical", "name": {{ entry.journal | jsonify }}
          {% if entry.volume %}}{% endif %}
          {% if entry.number %}}{% endif %}
        },
      {% endif %}
      {% if entry.eid %}"pagination": {{ entry.eid | jsonify }},{% elsif entry.pages %}"pagination": {{ entry.pages | replace: '--', '–' | jsonify }},{% endif %}
      "author": [
        {% for author in entry.author_array %}
          {% capture full_name %}{{ author.first }} {{ author.last }}{% endcapture %}
          {"@type": "Person", "name": {{ full_name | strip | jsonify }}}{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}
